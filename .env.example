# ── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key     # SERVER ONLY — never expose

# ── Resend ────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=hello@sakshisingla.com
RESEND_FROM_NAME=Dietitian Sakshi Singla
ADMIN_EMAIL=sakshi@sakshisingla.com                 # Where lead notifications go

# ── JWT (admin auth) ───────────────────────────────────
JWT_SECRET=replace-with-32+char-random-string
ADMIN_EMAIL_HASH=replace-with-bcrypt-hash           # bcrypt of admin login email
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash       # bcrypt of admin password

# ── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx  # Safe for client

# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sakshisingla.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210